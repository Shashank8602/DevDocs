# Copy to .env and adjust. Used by docker-compose and the backend.
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=devdocs
POSTGRES_DB=devdocs

DATABASE_URL=postgresql+asyncpg://devdocs:devdocs@localhost:5432/devdocs
ELASTICSEARCH_URL=http://localhost:9200
CORS_ORIGINS=http://localhost:5173

# Dev-only tools (Chunk Inspector, Retrieval Playground, ...)
DEV_MODE=true

# Embeddings (Phase 5): Gemini. The same key also serves chat when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=1536
# EMBEDDING_BATCH_SIZE=50
# EMBEDDING_MAX_RETRIES=5
# EMBEDDING_BACKOFF_SECONDS=2
# Client-side rate limits per provider (requests / tokens per minute, 0 = off). Keep just below your
# key's real quota. Same pattern for every provider: {GEMINI_EMBEDDING,GEMINI_LLM,GROQ_LLM}_{RPM,TPM}
# GEMINI_EMBEDDING_RPM=90
# GEMINI_EMBEDDING_TPM=25000
# GROQ_LLM_TPM=7000

# Retrieval (Phase 6). GATE_VECTOR_THRESHOLD is on the embedding model's cosine-score scale (tied to the
# embedding fingerprint): after changing the embedding config re-run `python -m eval.run` (from backend/)
# and pick a new one. See Docs/Plan/Retrieval.md.
# GATE_VECTOR_THRESHOLD=0.82
# RELATIVE_CUTOFF=0.04
# BM25_PROTECT=2
# Optional reranker, off by default. RERANK_TOP_N=5 turns it on for the first 5 candidates.
# RERANK_TOP_N=0
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_FINAL_TOP_K=5
# RETRIEVAL_CONTEXT_TOKENS=3000

# Chat (Phase 7). Which provider answers: groq | gemini (embeddings always use Gemini). Restart after changing.
# LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# LLM_MAX_OUTPUT_TOKENS=1500   # safety ceiling (reasoning tokens count), not a target length
# CHAT_HISTORY_MESSAGES=6
# CHAT_HISTORY_TOKENS=800

# --- Answer phase / resilience (Phases 9-10) and retrieval round 2 ---
# Second Groq model used only when the primary's per-minute token budget would make a question wait
# (Groq limits are per model). Empty = never. The fallback has its own budget (GROQ_LLM_FALLBACK_TPM).
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_FALLBACK_WAIT_SECONDS=6
# GROQ_LLM_FALLBACK_TPM=7000
# LLM_TEMPERATURE=0.2
# LLM_REASONING_EFFORT=low        # low | medium | high
# GENERATION_RETRIES=1            # silent retries before the first token
# LLM_INACTIVITY_SECONDS=45       # a stream silent for this long counts as failed
# SUMMARY_THRESHOLD_TOKENS=1200   # fold older messages into the conversation summary past this
# SUMMARY_KEEP_MESSAGES=2
# RETRIEVAL_TEST_PATH_FACTOR=0.8  # RRF-score multiplier for test-file chunks (1 = off)

# Dev-only fault injection (needs DEV_MODE=true): "once" fails the first attempt of a turn, "always" every attempt.
# FAULT_LLM=
# FAULT_RETRIEVAL=
