# Copy to .env and adjust. Used by docker-compose and the backend.
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=devdocs
POSTGRES_DB=devdocs

DATABASE_URL=postgresql+asyncpg://devdocs:devdocs@localhost:5432/devdocs
ELASTICSEARCH_URL=http://localhost:9200
CORS_ORIGINS=http://localhost:5173

# Dev-only tools (Chunk Inspector, Retrieval Playground, ...)
DEV_MODE=true

# Embeddings (Phase 5): Gemini. The same key also serves chat when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=1536
# EMBEDDING_BATCH_SIZE=50
# EMBEDDING_MAX_RETRIES=5
# EMBEDDING_BACKOFF_SECONDS=2
# Client-side rate limits per provider (requests / tokens per minute, 0 = off). Keep just below your
# key's real quota. Same pattern for every provider: {GEMINI_EMBEDDING,GEMINI_LLM,GROQ_LLM}_{RPM,TPM}
# GEMINI_EMBEDDING_RPM=90
# GEMINI_EMBEDDING_TPM=25000
# GROQ_LLM_TPM=7000

# Retrieval (Phase 6). GATE_VECTOR_THRESHOLD is on the embedding model's cosine-score scale (tied to the
# embedding fingerprint): after changing the embedding config re-run `python -m eval.run` (from backend/)
# and pick a new one. See Docs/Plan/Retrieval.md.
# GATE_VECTOR_THRESHOLD=0.82
# RELATIVE_CUTOFF=0.04
# BM25_PROTECT=2
# Optional reranker, off by default. RERANK_TOP_N=5 turns it on for the first 5 candidates.
# RERANK_TOP_N=0
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_FINAL_TOP_K=5
# RETRIEVAL_CONTEXT_TOKENS=3000

# Added in later phases
# Which provider answers chat: groq | gemini (embeddings always use Gemini)
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GEMINI_LLM_MODEL=gemini-3.5-flash-lite
